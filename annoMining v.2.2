def process_multiple_genomes(eggnog_files, interpro_files, species_names, output_dir='pharma_multi_analysis', prefix='multi', threshold=5):
    print(f"\n{'='*80}")
    print("MULTI-GENOME COMPARATIVE PHARMA ANALYSIS")
    print(f"{'='*80}")
    os.makedirs(output_dir, exist_ok=True)
    output_prefix = os.path.join(output_dir, prefix)
    genomes_data = {}
    all_pathways = set()
    
    for i, (eggnog_file, interpro_file, species) in enumerate(zip(eggnog_files, interpro_files, species_names)):
        print(f"\nProcessing {species}...")
        eggnog_data = parse_eggnog_universal(eggnog_file)
        interpro_data = parse_interpro_universal(interpro_file) if interpro_file else {'genes':set(),'pfam_domains':defaultdict(set),'go_terms':defaultdict(set),'interpro_domains':defaultdict(set)}
        merged = merge_pharma_data(eggnog_data, interpro_data, threshold)
        genomes_data[species] = merged
        for gene, info in merged.items():
            all_pathways.update(info['secondary_pathways'])
    
    print("\n📊 Consistência por genoma:")
    for species, merged in genomes_data.items():
        secondary = sum(1 for g in merged.values() if g['secondary_pathways'])
        pharma = sum(1 for g in merged.values() if g.get('pharma_score', 0) > 0)
        status = "✅" if pharma <= secondary else "⚠️"
        print(f"   {status} {species}: Secondary={secondary}, Pharma={pharma}")
        validate_pharma_groups(merged)
    
    create_comparative_summary_table(genomes_data, output_prefix)
    create_pathway_presence_matrix(genomes_data, all_pathways, output_prefix)
    create_comparative_bar_chart(genomes_data, output_prefix)
    create_comparative_radar_chart(genomes_data, output_prefix)
    create_heatmap_comparative(genomes_data, output_prefix)
    create_species_similarity_network(genomes_data, output_prefix)
    create_ranking_table(genomes_data, output_prefix)
    generate_comparative_report(genomes_data, output_prefix)
    
    print("\n📊 Gerando dotplots comparativos combinados...")
    create_comparative_dotplot(genomes_data, output_prefix, top_n=15)
    
    print(f"\n✅ Multi-genome analysis completed. Outputs in: {output_dir}")
    return True

