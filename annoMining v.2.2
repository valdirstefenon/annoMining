def run_secondary_analysis(eggnog_file, interpro_file, output_dir='secondary_metabolism', prefix='secondary'):
    print(f"\n{'='*80}")
    print("SECONDARY METABOLISM ANALYSIS")
    print(f"{'='*80}")
    print(f"Start: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
