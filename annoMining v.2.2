    def run_pharma_multi(self):
        eggnog_str = self.multi_eggnog.get().strip()
        interpro_str = self.multi_interpro.get().strip()
        names_str = self.multi_names.get().strip()
        outdir = self.multi_outdir.get().strip()
        threshold = int(self.multi_threshold.get().strip() or 5)
        if not eggnog_str or not names_str:
            messagebox.showerror("Error", "Please provide eggNOG files and species names.")
            return
        eggnog_files = [f.strip() for f in eggnog_str.split(',') if f.strip()]
        names = [n.strip() for n in names_str.split(',') if n.strip()]
        interpro_files = [f.strip() for f in interpro_str.split(',') if f.strip()] if interpro_str else []
        if len(eggnog_files) != len(names):
            messagebox.showerror("Error", "Number of eggNOG files must match number of species names.")
            return
        if interpro_files and len(interpro_files) != len(names):
            messagebox.showerror("Error", "If provided, number of InterPro files must match number of species.")
            return
        for f in eggnog_files:
            if not os.path.exists(f):
                messagebox.showerror("Error", f"File not found: {f}")
                return
        try:
            self.log(self.multi_log, "Starting multi-genome analysis...")
            interpro_list = interpro_files if interpro_files else [None]*len(names)
            process_multiple_genomes(eggnog_files, interpro_list, names, output_dir=outdir, prefix="multi", threshold=threshold)
            self.log(self.multi_log, f"✅ Multi-genome analysis completed. Outputs in: {outdir}")
            messagebox.showinfo("Success", f"Multi-genome analysis completed.\nOutputs in: {outdir}")
        except Exception as e:
            self.log(self.multi_log, f"❌ Error: {e}")
            messagebox.showerror("Error", str(e))

    def run_eggnog2kegg(self):
        infile = self.eggnog2kegg_input.get().strip()
        outfile = self.eggnog2kegg_output.get().strip()
        outdir = self.eggnog2kegg_outdir.get().strip()
        if not infile or not os.path.exists(infile):
            messagebox.showerror("Error", "Invalid input file.")
            return
        if not outfile:
            outfile = "kegg_mapper.txt"
        try:
            self.log(self.eggnog2kegg_log, "Converting eggNOG to KEGG format...")
            run_eggnog2kegg(infile, outfile, output_dir=outdir, prefix="kegg")
            self.log(self.eggnog2kegg_log, f"✅ Conversion completed. Output: {os.path.join(outdir, outfile)}")
            messagebox.showinfo("Success", f"Conversion completed.\nOutput: {os.path.join(outdir, outfile)}")
        except Exception as e:
            self.log(self.eggnog2kegg_log, f"❌ Error: {e}")
            messagebox.showerror("Error", str(e))

